digraph { graph [bgcolor="white",pad="0.2",ranksep="0.55"]; node [shape=box,style="rounded,filled",fillcolor="#EDF5F8",color="#7696A9",fontname="Arial",fontsize=15,margin="0.16,0.12"]; edge [fontname="Arial",fontsize=12,color="#35586F"]; rankdir=LR;PENDING->RESERVED->PAYMENT_PENDING->PAID->CONFIRMED;PENDING->REJECTED[label="sold out"];PAYMENT_PENDING->RELEASING[label="declined"];RELEASING->REJECTED;PAYMENT_PENDING->PAYMENT_PENDING[label="unknown retry"]; }